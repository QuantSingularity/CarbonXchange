# Copy this file to .env and fill in real values before deploying to a
# live network. Never commit the real .env file.

# Either MNEMONIC or PRIVATE_KEY is required for the polygon / polygonTestnet
# networks in truffle-config.js.
MNEMONIC=
PRIVATE_KEY=

# Optional custom RPC endpoints. Sensible public defaults are used if unset.
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Used by migrations/2_deploy_contracts.js to configure the deployed
# contracts. Defaults to the deployer account when unset.
FEE_RECIPIENT_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
