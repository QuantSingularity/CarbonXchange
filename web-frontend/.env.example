# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Feature Flags
VITE_USE_MOCK_SOCKET=false
VITE_USE_MOCK_DATA=false

# Environment
VITE_APP_ENV=development

# Application Settings
VITE_APP_NAME=CarbonXchange
VITE_APP_VERSION=1.0.0

# Block explorer used to link out from on-chain tx hashes / contract
# addresses shown in the UI (e.g. on the project detail page). Should
# match the network the backend's WEB3_CHAIN_ID is configured for.
VITE_BLOCK_EXPLORER_URL=https://polygonscan.com
