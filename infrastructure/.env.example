# CarbonXchange Local Development Environment Variables
# Copy this file to .env and fill in values before running docker compose
# NEVER commit .env to version control

# ── Database ──────────────────────────────────────────────────────────────────
# The backend depends on psycopg2-binary (PostgreSQL) — see
# code/backend/requirements.txt — not MySQL/MariaDB.
POSTGRES_DB=carbonxchange
POSTGRES_USER=carbonxchange
POSTGRES_PASSWORD=dev-db-password-change-me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=dev-redis-password-change-me

# ── Backend secrets (min 32 chars) ─────────────────────────────────────────────
SECRET_KEY=dev-flask-secret-key-at-least-32-chars-long
JWT_SECRET_KEY=dev-jwt-secret-at-least-32-chars-long
ENCRYPTION_KEY=dev-encryption-key-exactly-32chars!
API_KEY_SALT=dev-api-key-salt-change-me

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
